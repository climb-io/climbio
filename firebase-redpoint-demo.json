{
  "hosting": {
    "site": "climbio-redpoint-demo",
    "public": "demo/capture-redpoint",
    "ignore": [
      "**/.*",
      "**/node_modules/**",
      "*.webm",
      "video-mobile/**",
      "video-desktop/**"
    ],
    "headers": [
      {
        "source": "**/*.mp4",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=300"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}

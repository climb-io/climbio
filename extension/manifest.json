{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.3.1",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://image.thecrag.com/*",
    "https://i0.wp.com/*",
    "https://hongkongclimbing.com/*",
    "https://api.openstreetmap.org/*",
    "https://commons.wikimedia.org/*",
    "https://upload.wikimedia.org/*",
    "https://photos.app.goo.gl/*",
    "https://photos.google.com/*",
    "https://lh3.googleusercontent.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://climbio.app/*",
      "https://climbio.web.app/*",
      "https://climbio-dev.web.app/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_icon": {
      "16": "icons/redpoint-cat-16.png",
      "32": "icons/redpoint-cat-32.png",
      "48": "icons/redpoint-cat-48.png",
      "128": "icons/redpoint-cat-128.png"
    }
  },
  "icons": {
    "16": "icons/redpoint-cat-16.png",
    "32": "icons/redpoint-cat-32.png",
    "48": "icons/redpoint-cat-48.png",
    "128": "icons/redpoint-cat-128.png"
  },
  "default_locale": "zh_TW"
}

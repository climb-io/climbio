{
  "firestore": [
    {
      "database": "climbio",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "climbio",
    "public": "dist",
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self'"
          }
        ]
      },
      {
        "source": "**/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css|webmanifest|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/i18n/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/holdkit/models/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/icons/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/r/*/*/route.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/3d/**",
        "headers": [
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=()"
          }
        ]
      },
      {
        "source": "/3d/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/3d/camera-*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/lab/wall2d-cam/**",
        "headers": [
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=()"
          }
        ]
      },
      {
        "source": "/lab/wall2d-cam/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/lab/wall2d-cam/camera-*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/redpoint/vendor/opencv-*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.onnx",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=86400"
          }
        ]
      }
    ],
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/r/**",
        "function": {
          "functionId": "routePage",
          "region": "asia-east1"
        }
      },
      {
        "source": "/p/*",
        "function": {
          "functionId": "routePage",
          "region": "asia-east1"
        }
      },
      {
        "source": "/p/*/",
        "function": {
          "functionId": "routePage",
          "region": "asia-east1"
        }
      }
    ],
    "redirects": [
      {
        "source": "/p/:id/:file",
        "destination": "https://huggingface.co/datasets/climbio/crags/resolve/main/crags/:id/:file",
        "type": 302
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "climbio",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ],
      "predeploy": [
        "node tools/functions-predeploy.mjs vendor format/format.js redpoint/world-data.mjs redpoint/openclimbing-group.mjs redpoint/world-stacks.mjs redpoint/thecrag-links.mjs"
      ]
    }
  ]
}

{
  "firestore": [
    {
      "database": "climbio",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "climbio",
    "public": "dist",
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self'"
          }
        ]
      },
      {
        "source": "**/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css|webmanifest|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/i18n/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/holdkit/models/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/icons/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/r/*/*/route.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/climbio.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=600"
          }
        ]
      },
      {
        "source": "/w/gym/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=600"
          }
        ]
      },
      {
        "source": "/w/*/routes.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=600"
          }
        ]
      },
      {
        "source": "/w/*/shared.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=60, s-maxage=60"
          }
        ]
      },
      {
        "source": "/w/*/@(wall.json|photo.jpg|thumb.jpg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/dir/gyms.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/3d/**",
        "headers": [
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=()"
          }
        ]
      },
      {
        "source": "/3d/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/3d/camera-*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/lab/wall2d-cam/**",
        "headers": [
          {
            "key": "Permissions-Policy",
            "value": "camera=(self), microphone=()"
          }
        ]
      },
      {
        "source": "/lab/wall2d-cam/manifest.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/lab/wall2d-cam/camera-*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/redpoint/vendor/opencv-*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "**/*.onnx",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=86400"
          }
        ]
      }
    ],
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/r/**",
        "function": {
          "functionId": "routePage",
          "region": "asia-east1"
        }
      },
      {
        "source": "/climbio.json",
        "function": {
          "functionId": "routePage",
          "region": "asia-east1"
        }
      },
      {
        "source": "/w/**",
        "function": {
          "functionId": "routePage",
          "region": "asia-east1"
        }
      },
      {
        "source": "/dir/**",
        "function": {
          "functionId": "siteDirectory",
          "region": "asia-east1"
        }
      },
      {
        "source": "/p/**",
        "function": {
          "functionId": "projectFiles",
          "region": "asia-east1"
        }
      },
      {
        "source": "/album",
        "function": {
          "functionId": "album",
          "region": "asia-east1"
        }
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "climbio",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ],
      "predeploy": [
        "node tools/functions-predeploy.mjs vendor format/format.js redpoint/world-data.mjs redpoint/openclimbing-group.mjs redpoint/world-stacks.mjs redpoint/thecrag-links.mjs"
      ]
    },
    {
      "source": "holdkit/functions",
      "codebase": "holdkit",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "*.local"
      ],
      "predeploy": [
        "node tools/functions-predeploy.mjs models holdkit/models/mobilesam-encoder.onnx holdkit/models/mobilesam-decoder.onnx"
      ]
    }
  ]
}

{
  "name": "@climbio/routekit",
  "version": "1.1.0",
  "description": "Climbing route viewer and editor on a wall photo: route image, start/finish tape, hand order, tap holds to set a route. No framework, no build step.",
  "license": "AGPL-3.0-or-later",
  "repository": { "type": "git", "url": "git+https://github.com/climb-io/climbio.git", "directory": "routekit" },
  "keywords": ["climbing", "bouldering", "spray-wall", "route", "canvas", "web-component"],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.mjs", "require": "./index.js" },
    "./elements": { "types": "./elements.d.ts", "default": "./elements.js" },
    "./*.js": "./*.js",
    "./package.json": "./package.json"
  },
  "sideEffects": ["./elements.js"],
  "files": ["*.js", "*.mjs", "*.d.ts", "*.html", "README.md", "README.en.md", "LICENSE", "NOTICE"]
}
